# --- Local runs need NONE of this (the economy runs fully on a local Hardhat chain) ---

# --- Arc Testnet (only for live on-chain runs) ---
# A faucet-funded Arc Testnet private key. Get test USDC from https://faucet.circle.com
PRIVATE_KEY=0xYOUR_ARC_TESTNET_PRIVATE_KEY
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Circle Gateway facilitator (x402 settlement) — defaults are fine
GATEWAY_API=https://gateway-api-testnet.circle.com

# Settlement backend: "local" (real ERC-20 transfers on Hardhat) or "arc" (Circle Gateway/Nanopayments)
SETTLEMENT=local

# Operator secret for admin routes (POST /x402/admin/claim/:id/resolve). Unset → admin routes are disabled (404).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_ADMIN_TOKEN=

# Proxies in front of the server (the real client IP is this many entries from the RIGHT of X-Forwarded-For).
# Defaults: 3 on Render (client, Cloudflare, Render LB — measured), 0 elsewhere (use the socket address).
# TRUST_PROXY_HOPS=

# --- Run the public MARKETPLACE on real Arc (the agent economy stays on its sandbox chain) ---
# MARKET_CHAIN=arc settles every marketplace call as a real Circle Gateway nanopayment on Arc Testnet.
# Needs PRIVATE_KEY above (funded; it's the ServiceBond/InsurancePool manager from deployments/arcTestnet.json).
# MARKET_CHAIN=arc
# ARC_TAB_CAP_USDC=0.01            # free demo credit per visitor tab (a real Gateway deposit)
# ARC_TAB_DAILY_BUDGET_USDC=0.5    # max the operator spends on demo tabs per day (cap + ~$0.008 gas each)
# ARC_TAB_POOL=2                   # tabs kept pre-funded so "open tab" is instant
